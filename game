# 2. Click the Correct Color Name
function MiniGame2_ColorMatch {
 $pnlGameArea.Controls.Clear()
 Write-Log "MINIGIER 2: WYBIERZ WŁAŚCIWY KOLOR" "Cyan"
 
 $colors = @{
 "RED" = [System.Drawing.Color]::Red
 "BLUE" = [System.Drawing.Color]::Blue
 "GREEN" = [System.Drawing.Color]::Green
 "YELLOW" = [System.Drawing.Color]::Yellow
 "WHITE" = [System.Drawing.Color]::White
 "CYAN" = [System.Drawing.Color]::Cyan
 }
 $keys = $colors.Keys
 $targetName = $keys | Get-Random
 $targetColor = $colors[$targetName]
 
 # Zapisz w zmiennej globalnej, closure nie ma dostępu do lokalnej w PS5.1
 $Global:TargetColorName = $targetName
 
 $lblDisplay = New-Object System.Windows.Forms.Label
 $lblDisplay.BackColor = $targetColor
 $lblDisplay.Size = New-Object System.Drawing.Size(200, 200)
 $lblDisplay.Location = New-Object System.Drawing.Point($pnlGameArea.Width / 2 - 100, 50)
 $pnlGameArea.Controls.Add($lblDisplay)
 
 $lblQ = New-Object System.Windows.Forms.Label
 $lblQ.Text = "Jaki to kolor?"
 $lblQ.Font = New-Object System.Drawing.Font("Consolas", 16, [System.Drawing.FontStyle]::Bold)
 $lblQ.Location = New-Object System.Drawing.Point($pnlGameArea.Width / 2 - 80, 280)
 $pnlGameArea.Controls.Add($lblQ)
 
 $btns = @()
 $options = @($targetName)
 while ($options.Count -lt 3) {
 $opt = $keys | Where-Object { $_ -ne $targetName } | Get-Random
 if ($options -notcontains $opt) { $options += $opt }
 }
 
 $yPos = 350
 foreach ($opt in $options) {
 $btn = New-Object System.Windows.Forms.Button
 $btn.Text = $opt
 $btn.Size = New-Object System.Drawing.Size(150, 40)
 $btn.Location = New-Object System.Drawing.Point(($pnlGameArea.Width / 2) - 75, $yPos)
 $yPos += 50
 
 $btn.Add_Click({
 if (-not $GameState.IsGameOver) {
 # Używamy $btn.Text z zamknięcia
 if ($btn.Text -eq $Global:TargetColorName) {
 WinGame
 } else {
 HandleLoss
 }
 }
 })
 $btns += $btn
 $pnlGameArea.Controls.Add($btn)
 }
}

