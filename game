# 4. Math Quiz
function MiniGame4_Math {
 $pnlGameArea.Controls.Clear()
 Write-Log "MINIGIER 4: ROZWIĄZ RÓWNANIE" "Cyan"
 
 $a = Get-Random -Minimum 1 -Maximum 20
 $b = Get-Random -Minimum 1 -Maximum 20
 $ops = @("+", "-", "*")
 $op = $ops | Get-Random
 
 $result = 0
 switch ($op) {
 "+" { $result = $a + $b }
 "-" { $result = $a - $b }
 "*" { $result = $a * $b }
 }
 
 # Zapisz w zmiennej globalnej
 $Global:MathResult = $result
 
 $lblQ = New-Object System.Windows.Forms.Label
 $lblQ.Text = "$a $op $b = ?"
 $lblQ.Font = New-Object System.Drawing.Font("Consolas", 32, [System.Drawing.FontStyle]::Bold)
