# 8. Avoid the Box
function MiniGame8_Avoid {
 $pnlGameArea.Controls.Clear()
 Write-Log "MINIGIER 8: TRAKAJ 5 SEKUND" "Cyan"
 
 $lblTimer = New-Object System.Windows.Forms.Label
 $lblTimer.Text = "5.00"
 $lblTimer.Font = New-Object System.Drawing.Font("Consolas", 48, [System.Drawing.FontStyle]::Bold)
 $lblTimer.ForeColor = [System.Drawing.Color]::White
 $lblTimer.Location = New-Object System.Drawing.Point($pnlGameArea.Width / 2 - 100, 150)
 $pnlGameArea.Controls.Add($lblTimer)
 
 $threat = New-Object System.Windows.Forms.Button
 $threat.Text = "X"
 $threat.BackColor = [System.Drawing.Color]::Red
 $threat.Size = New-Object System.Drawing.Size(50, 50)
 $threat.Location = New-Object System.Drawing.Point($pnlGameArea.Width / 2 - 25, 250)
 $threat.BringToFront()
 
 $threatTimer = New-Object System.Windows.Forms.Timer
 $threatTimer.Interval = 100
 $threatTimer.Add_Tick({
 if (-not $GameState.IsGameOver) {
 $threat.Location = New-Object System.Drawing.Point(
 (Get-Random -Minimum 0 -Maximum ($pnlGameArea.Width - 50)),
 (Get-Random -Minimum 0 -Maximum ($pnlGameArea.Height - 50))
 )
 }
 })
 $threatTimer.Start()
 
 $countdown = 5.0
 $timer = New-Object System.Windows.Forms.Timer
 $timer.Interval = 100
 $timer.Add_Tick({
 if (-not $GameState.IsGameOver) {
 $countdown -= 0.1
 $lblTimer.Text = $countdown.ToString("F2")
 if ($countdown -le 0) {
 $timer.Stop()
 $threatTimer.Stop()
 # Usuń timery z formularza, żeby nie działały w tle
 $Form.Controls.Remove($timer)
 $Form.Controls.Remove($threatTimer)
 WinGame
 }
 }
 })
 $timer.Start()
}

