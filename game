# Mapowanie minigier do funkcji
$MiniGames = @(
 $null, # 0 index unused
 $Function:MiniGame1_Click,
 $Function:MiniGame2_ColorMatch,
 $Function:MiniGame3_Memory,
 $Function:MiniGame4_Math,
 $Function:MiniGame5_Hover,
 $Function:MiniGame6_MultiClick,
 $Function:MiniGame7_Type,
 $Function:MiniGame8_Avoid,
 $Function:MiniGame9_SmallTarget,
 $Function:MiniGame10_Switch
)

function WinGame {
 if ($GameState.IsGameOver) { return }
 $GameState.Score += 100 + ($GameState.Level * 10)
 $GameState.Streak++
 Write-Log "WYGRANA! +$($GameState.Score)" "Green"
 Update-UI
 Start-Sleep -Milliseconds 300
 Start-NextMiniGame
}

function HandleLoss {
 if ($GameState.IsGameOver) { return }
 $GameState.Integrity -= 10
 $GameState.Streak = 0
 Write-Log "PRZEGRANA! Usuwam pliki i zbliżam się do formatowania..." "Red"
 
 Remove-SysFile
 Update-UI
 Check-GameOver
 
 if (-not $GameState.IsGameOver) {
 Start-Sleep -Milliseconds 500
 # Restart tej samej minigierki
 $MiniGames[$GameState.CurrentMiniGameId].Invoke()
 }
}

function Start-NextMiniGame {
 if ($GameState.IsGameOver) { return }
 $GameState.Level++
 Update-UI
 
 # Losuj minigierkę (1-10)
 $nextGameId = Get-Random -Minimum 1 -Maximum 11
 $GameState.CurrentMiniGameId = $nextGameId
 
 # Wywołaj minigierkę
 $MiniGames[$nextGameId].Invoke()
}

function Start-BootSequence {
 Write-Log "URUCHAMIANIE SYSTEMU..." "Cyan"
 $pnlGameArea.Controls.Clear()
 
 $lblBoot = New-Object System.Windows.Forms.Label
 $lblBoot.Text = "INITIALIZING..."
 $lblBoot.Font = New-Object System.Drawing.Font("Consolas", 24, [System.Drawing.FontStyle]::Bold)
 $lblBoot.Location = New-Object System.Drawing.Point($pnlGameArea.Width / 2 - 150, $pnlGameArea.Height / 2 - 50)
 $pnlGameArea.Controls.Add($lblBoot)
 
 Start-Sleep -Milliseconds 2000
 $lblBoot.Text = "LOADING MODULES..."
 Start-Sleep -Milliseconds 1000
 $lblBoot.Text = "SYSTEM READY"
 Start-Sleep -Milliseconds 500
 
 $pnlGameArea.Controls.Clear()
 Start-NextMiniGame
}

