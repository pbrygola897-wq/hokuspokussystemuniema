function Log-History {
    param([string]$Message, [string]$Type = "INFO")
    $entry = "[$(Get-Date -Format 'HH:mm:ss')] [$Type] $Message"
    $null = $GameState["History"].Add($entry)
    $Form.Invoke([Action]{
        if ($txtLog.Lines.Count -gt 50) { $txtLog.Text = ($GameState["History"] | Select-Object -Last 50) -join "`n" }
        else { $txtLog.AppendText("$entry`n") }
    })
}

function Show-Glitch {
    param([int]$Duration = 500)
    $Form.Invoke([Action]{
        $oldBG = $Form.BackColor; $Form.BackColor = [System.Drawing.Color]::Black
        $Form.Controls | ForEach-Object { $_.Visible = $false }
        $lblGlitch = New-Object System.Windows.Forms.Label
        $lblGlitch.Text = "ERR_0x$(Get-Random -Min 1000 -Max 9999)"
        $lblGlitch.ForeColor = [System.Drawing.Color]::Red
        $lblGlitch.Font = New-Object System.Drawing.Font("Consolas", 16, [System.Drawing.FontStyle]::Bold)
        $lblGlitch.Location = New-Object System.Drawing.Point(100, 100)
        $Form.Controls.Add($lblGlitch)
        Start-Sleep -Milliseconds $Duration
        $Form.Controls.Remove($lblGlitch)
        $Form.Controls | ForEach-Object { $_.Visible = $true }
        $Form.BackColor = $oldBG; $Form.Refresh()
    })
}

function Play-SoundEffect {
    try { [System.Media.SoundPlayer]::new("C:\Windows\Media\chord.wav").Play() | Out-Null } catch {}
}

function Remove-SystemFile {
    param([string]$FilePath)
    if ($null -eq $FilePath -and $GameState["SystemFilesList"].Count -gt 0) {
        $index = Get-Random -Minimum 0 -Maximum $GameState["SystemFilesList"].Count
        $fileObj = $GameState["SystemFilesList"][$index]; $FilePath = $fileObj.Name
    }
    if ($null -ne $FilePath) {
        Log-History "Próba usunięcia: $FilePath" "DELETE"
        $result = Remove-SystemFileWithPrivilege -FilePath $FilePath
        if ($result -eq "Success") {
            Log-History "Fizyczne usunięto: $FilePath" "SUCCESS"
            $GameState["FilesRemoved"]++; $GameState["Integrity"] = [Math]::Max(0, $GameState["Integrity"] - 1)
            $GameState["SystemFilesList"] = $GameState["SystemFilesList"] | Where-Object { $_.Name -ne $FilePath }
        } else {
            Log-History "Plik w użyciu: $FilePath" "WARN"
            $GameState["Integrity"] = [Math]::Max(0, $GameState["Integrity"] - 0.5)
        }
    }
}

function Apply-Punishment {
    $penaltyLevel = [Math]::Min(5, [Math]::Ceiling($GameState["Streak"] / 2))
    for ($i = 0; $i -lt $penaltyLevel; $i++) { Remove-SystemFile }
    if ($GameState["Integrity"] -le 0) { Trigger-Crisis }
}

function Trigger-Crisis {
    $GameState["CrisisMode"] = $true
    $Form.Invoke([Action]{
        $Form.BackColor = [System.Drawing.Color]::DarkRed
        $lblStatus.Text = "KRIZA SYSTEMU!"
        $lblStatus.ForeColor = [System.Drawing.Color]::Yellow
    })
    Show-Glitch 1000; Log-History "SYSTEM NA KRAWĘDZI" "CRISIS"
}

function Update-UI {
    $Form.Invoke([Action]{
        $lblIntegrity.Text = "INTEGRITY: $($GameState['Integrity'])%"
        $lblScore.Text = "SCORE: $($GameState['Score'])"
        $lblStreak.Text = "STREAK: $($GameState['Streak'])"
        $lblFiles.Text = "FILES LOST: $($GameState['FilesRemoved'])"
        $lblLevel.Text = "LEVEL: $($GameState['Level'])"
        if ($GameState["Integrity"] -lt 30) { $Form.BackColor = [System.Drawing.Color]::Maroon }
        elseif ($GameState["Integrity"] -lt 60) { $Form.BackColor = [System.Drawing.Color]::DarkRed }
        else { $Form.BackColor = [System.Drawing.Color]::Black }
    })
}

