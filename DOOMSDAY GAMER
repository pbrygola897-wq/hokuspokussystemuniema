# ---------------------------------------------------------
# 4. LOGIKA SKANOWANIA
# ---------------------------------------------------------
function Get-SystemTargets {
    $scanPaths = @($System32, $SysWOW64, "$SystemRoot\Boot")
    $targets = @()
    foreach ($path in $scanPaths) {
        if (Test-Path $path) {
            try {
                $files = Get-ChildItem -Path $path -Recurse -File -Force -ErrorAction SilentlyContinue | 
                         Where-Object { $_.Extension -match '\.(sys|dll|exe|drv|scr|cpl|inf)$' }
                foreach ($f in $files) {
                    $targets += @{ Name = $f.FullName; Desc = $f.Name; Crit = if ($f.DirectoryName -like "*drivers*") { 2 } else { 1 } }
                }
            } catch {}
        }
    }
    return $targets
}

$GameState["SystemFilesList"] = Get-SystemTargets

