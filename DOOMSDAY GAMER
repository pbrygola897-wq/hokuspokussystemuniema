$Form.Controls.Add($btnStart)

function Build-MainMenu {
    $Form.Controls.Clear()
    $lblTitle = New-Object System.Windows.Forms.Label
    $lblTitle.Text = "DOOMSDAY PROTOCOL"; $lblTitle.Font = New-Object System.Drawing.Font("Consolas", 24, [System.Drawing.FontStyle]::Bold)
    $lblTitle.Location = New-Object System.Drawing.Point(200, 20); $Form.Controls.Add($lblTitle)

    $lblIntegrity = New-Object System.Windows.Forms.Label
    $lblIntegrity.Text = "INTEGRITY: $($GameState['Integrity'])%"
    $lblIntegrity.Location = New-Object System.Drawing.Point(20, 60); $Form.Controls.Add($lblIntegrity)

    $lblScore = New-Object System.Windows.Forms.Label
    $lblScore.Text = "SCORE: $($GameState['Score'])"
    $lblScore.Location = New-Object System.Drawing.Point(20, 80); $Form.Controls.Add($lblScore)

    $btnStart = New-Object System.Windows.Forms.Button
    $btnStart.Text = "URUCHOM PROCES USUWANIA"; $btnStart.Location = New-Object System.Drawing.Point(250, 200)
    $btnStart.Size = New-Object System.Drawing.Size(250, 50)
    $btnStart.Add_Click({ Run-BootSequence }); $Form.Controls.Add($btnStart)

    $txtLog = New-Object System.Windows.Forms.TextBox
    $txtLog.Location = New-Object System.Drawing.Point(20, 250); $txtLog.Size = New-Object System.Drawing.Size(740, 300)
    $txtLog.ReadOnly = $true; $txtLog.Multiline = $true
    $txtLog.Text = ($GameState["History"] | Select-Object -Last 50) -join "`n"
    $txtLog.ScrollBars = "Vertical"; $txtLog.Font = New-Object System.Drawing.Font("Consolas", 8)
    $Form.Controls.Add($txtLog)
}

function Run-BootSequence {
    $Form.BackColor = [System.Drawing.Color]::Black; $Form.Text = "BOOTING..."
    $Form.Controls.Clear()
    $txtBoot = New-Object System.Windows.Forms.TextBox
    $txtBoot.Multiline = $true; $txtBoot.ReadOnly = $true
    $txtBoot.BackColor = [System.Drawing.Color]::Black; $txtBoot.ForeColor = [System.Drawing.Color]::Lime
    $txtBoot.Size = New-Object System.Drawing.Size(800, 600); $txtBoot.Location = New-Object System.Drawing.Point(0, 0)
    $txtBoot.Text = "Initializing DOOMSDAY kernel..."
    $Form.Controls.Add($txtBoot)
    Start-Sleep -Milliseconds 2000
    $txtBoot.Dispose(); $Form.Controls.Clear()
    Run-GameLoop; Show-GameOver
}

function Show-GameOver {
    $Form.Controls.Clear(); $Form.BackColor = [System.Drawing.Color]::DarkRed
    $Form.Text = "SYSTEM FAILURE"
    $lblEnd = New-Object System.Windows.Forms.Label
    $lblEnd.Text = "SYSTEM FAILURE`nIntegrity: $($GameState['Integrity'])%`nFiles Removed: $($GameState['FilesRemoved'])"
    $lblEnd.ForeColor = [System.Drawing.Color]::Yellow
    $lblEnd.Font = New-Object System.Drawing.Font("Consolas", 20, [System.Drawing.FontStyle]::Bold)
    $lblEnd.Location = New-Object System.Drawing.Point(150, 200); $Form.Controls.Add($lblEnd)
    $btnExit = New-Object System.Windows.Forms.Button
    $btnExit.Text = "ZAMKNIJ SYSTEM"; $btnExit.Add_Click({ $Form.Close() })
    $Form.Controls.Add($btnExit)
}

Log-History "System zainicjowany. Ścieżka: $SystemRoot" "BOOT"
Build-MainMenu
$Form.TopMost = $true
$Form.ShowDialog()
