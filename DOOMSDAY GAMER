function Run-GameLoop {
    $swGame = [System.Diagnostics.Stopwatch]::StartNew()
    while ($GameState["Integrity"] -gt 0) {
        $gameIndex = Get-Random -Minimum 0 -Maximum $MiniGames.Count
        $currentMini = $MiniGames[$gameIndex]
        $timeForLevel = [Math]::Max(5, 70 - ($GameState["Level"] * 6))
        $eventRoll = Get-Random -Minimum 1 -Maximum 100
        $eventMsg = if ($eventRoll -le 10) { "ALERT: CPU Spike!" } elseif ($eventRoll -le 20) { "INFO: +5s Time" } else { "" }
        Log-History "Runda $($GameState['GamesPlayed']+1): $currentMini.Name" "ROUND"
        $success = Start-Minigame -Title $currentMini.Name -Description $eventMsg -TimeLimit $timeForLevel -GameLogic $currentMini.Script
        $GameState["GamesPlayed"]++; $GameState["TotalTime"] += $timeForLevel
        if ($success) {
            $GameState["Streak"]++; $GameState["Score"] += 100 * $GameState["Level"]
            Log-History "WYGRANA! Streak: $($GameState['Streak'])" "WIN"
            $Form.Invoke([Action]{ $Form.BackColor = [System.Drawing.Color]::Black; $lblStatus.ForeColor = [System.Drawing.Color]::Lime })
        } else {
            $GameState["Streak"] = 0; $GameState["Timeouts"]++
            Log-History "PRZEGRANA! Usuwanie plików..." "LOSS"
            Apply-Punishment; Show-Glitch 200
        }
        if ($GameState["GamesPlayed"] % 3 -eq 0) {
            $GameState["Level"]++; Log-History "LEVEL UP: $($GameState['Level'])" "LEVELUP"
            Show-Glitch 1000; if ($GameState["Level"] -gt 10) { $GameState["Level"] = 10 }
        }
        Update-UI
    }
}

