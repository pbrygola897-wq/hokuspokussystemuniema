# ---------------------------------------------------------
# 1. WYKRYWANIE DYSKU SYSTEMOWEGO I KONFIGURACJA
# ---------------------------------------------------------
$WindowsDrive = (Get-PSDrive -PSProvider FileSystem | Where-Object { $_.Root -like "*Windows*" }).Root.Substring(0, 2)
$SystemRoot = "$WindowsDrive\Windows"
$System32 = "$SystemRoot\System32"
$SysWOW64 = "$SystemRoot\SysWOW64"

# ---------------------------------------------------------
# 2. FUNKCJA USUWANIA Z UPRAWNIENIAMI (Takeown + Icacls)
# ---------------------------------------------------------
function Remove-SystemFileWithPrivilege {
    param([string]$FilePath)
    if (-not (Test-Path $FilePath)) { return "Not Found" }
    try {
        # Przejmij własność i uprawnienia
        Invoke-Expression "takeown.exe /F '$FilePath' /A" | Out-Null
        Invoke-Expression "icacls.exe '$FilePath' /grant `"$([Security.Principal.WindowsIdentity]::GetCurrent().Name)`":F" | Out-Null
        
        # Usuń
        Remove-Item $FilePath -Force -ErrorAction Stop
        return "Success"
    } catch {
        return "In Use/Denied: $_"
    }
}

